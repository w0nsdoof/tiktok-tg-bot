BOT_TOKEN=your-telegram-bot-token
# Admin user IDs — can approve/deny access requests and add users by forwarding
ADMIN_USER_IDS=[123456789]
# Seed user IDs — imported as regular (non-admin) users on first startup
ALLOWED_USER_IDS=[987654321,111222333]
MAX_DURATION=300
MAX_FILE_SIZE=50
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_DIR=/tmp/tg-bot-downloads
# Optional Netscape-format Instagram cookies file for private/rate-limited posts
# INSTAGRAM_COOKIES_FILE=/app/src/data/instagram-cookies.txt
DATA_DIR=data
LOG_LEVEL=INFO
LOG_JSON=false
# Optional: Postgres DSN for usage analytics; unset = analytics disabled
# ANALYTICS_DSN=postgresql://user:pass@host:5432/dbname
# Primary app database. If unset, ANALYTICS_DSN is reused for access and settings.
# DATABASE_DSN=postgresql://user:pass@host:5432/dbname

# Authentik-backed web control panel
CONTROL_PANEL_URL=https://bot.w0nsdoof.com
WEB_SESSION_SECRET=replace-with-a-long-random-value
# Browser permissions are refreshed from Authentik after this many seconds.
WEB_SESSION_MAX_AGE=900
AUTHENTIK_ISSUER=https://auth.w0nsdoof.com/application/o/tiktok-bot
AUTHENTIK_CLIENT_ID=tiktok-bot
AUTHENTIK_CLIENT_SECRET=replace-with-the-oidc-client-secret
AUTHENTIK_OPERATOR_GROUP=tiktok-bot-operators
AUTHENTIK_ADMIN_GROUP=tiktok-bot-admins
